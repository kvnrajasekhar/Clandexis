# ==============================================================================
# Clandexis (Invisible ERP) Environment Configuration
# ==============================================================================

# Google Cloud Platform (GCP)
GCP_PROJECT_ID=clandexis
GCP_REGION=asia-south1
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=clandexis_analytics

# Google AI & Gemini API
# Linked to clandexis GCP Billing Account
GEMINI_API_KEY=your_gemini_api_key_here
ROUTER_MODEL=gemini-3.5-flash-lite
EXTRACTOR_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-tts
ANALYST_MODEL=gemini-4-carbon

# Meta WhatsApp Business Cloud API (Graph API v21.0)
META_WHATSAPP_TOKEN=your_meta_system_user_permanent_access_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WABA_ID=your_whatsapp_business_account_id_here
META_VERIFY_TOKEN=clandexis_meta_webhook_verify_token_2026
META_APP_SECRET=your_meta_app_secret_for_hmac_sha256_validation

# Twilio WhatsApp Sandbox (Backup Adapter)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google Cloud KMS Attestation
KMS_KEY_RING=clandexis-attestation-ring
KMS_KEY_NAME=ledger-signing-key
KMS_LOCATION=asia-south1

# Cloud Storage (PDF Invoices & Attested Reports)
GCS_BUCKET_NAME=clandexis-pdf-artifacts

# Service Configuration
PORT=8080
LOG_LEVEL=INFO
ENVIRONMENT=development
CONFIDENCE_THRESHOLD=0.85
HIGH_CREDIT_THRESHOLD=5000.00
